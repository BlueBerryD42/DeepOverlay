{
    "name": "deep-overlay-extension",
    "version": "1.0.0",
    "description": "Chrome MV3 extension: DOM-anchored web annotations with local storage",
    "license": "MIT",
    "keywords": [
        "chrome-extension",
        "manifest-v3",
        "annotation",
        "sticky-notes",
        "browser-extension"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build:adapters": "esbuild lib/site-adapters.mjs --bundle --format=iife --global-name=DeepOverlayAdapters --outfile=adapters.js",
        "build:options": "vite build && node scripts/copy-extension-ui.js",
        "dev:options": "vite build --watch",
        "build:all": "npm run build:adapters && npm run build:options"
    },
    "dependencies": {},
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.3.0",
        "esbuild": "^0.25.0",
        "vite": "^7.3.1"
    }
}
